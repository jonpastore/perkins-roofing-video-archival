# Non-secret deploy configuration — COMMITTED ON PURPOSE (R3: git is the source of truth).
#
# scripts/deploy.sh used to read these from an untracked local .env, which meant a deploy was only
# reproducible on the one laptop that had that file. Anywhere else — and CI in particular — the
# values resolved to "" and the deploy silently OVERWROTE prod's config with blanks.
#
# Everything here is public by design: a site URL, a username, an OAuth *client* id (shipped to
# browsers), and service URLs. NOTHING SECRET GOES IN THIS FILE. Credentials live in Secret
# Manager and are injected via --set-secrets; see local.secret_ids in infra/main.tf.
#
# A local .env still wins for development (deploy.sh sources this first, then .env).

WP_URL=https://1251216.us6.myftpupload.com
WP_USER=jon
OAUTH_CLIENT_ID=981279422576-afa5jspjffd447puojs40m3f6s9qcra9.apps.googleusercontent.com
SIGN_PUBLIC_URL=https://sign.perkinsroofing.net
OAUTH_REDIRECT_BASE=https://api-jnr6bsxyea-uc.a.run.app

# Outbound email gate (core/email_gate.decide). "test" restricts delivery to the allowlist below.
# ⚠️ DO NOT flip to "live" without Jon — that turns on real customer email.
EMAIL_SEND_MODE=test
EMAIL_TEST_RECIPIENT_ALLOWLIST=jpastore79@gmail.com,@degenito.ai,@perkinsroofing.net

# Owner channel for YouTube reply posting. Empty in prod today; the canonical id is
# UChJZpBYXOuR0j1EHJugv5hg (== the @perkinsroofingcorp handle — verified 2026-07-28, both URLs
# resolve to the same channel and YouTube canonicalises to the id form). Left blank to match the
# running service exactly; set it here when the reply flow is turned on.
YT_OWNER_CHANNEL_ID=
