# Databases & downloaded media (large, regenerable)
*.db
poc/data/
tmp/

# Python caches
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# Logs
logs/
*.log

# Local tooling state
.omc/
.morpheus-ek/
.grok/

# Local business drafts — not product source
DeGenito-Perkins-Partnership-Proposal-*.docx
DeGenito-Perkins-Partnership-Proposal-*.pdf
.claude/*
# Project-scoped SKILLS are meant to be shared — they encode repo rules the whole team
# (and every future session) should follow. Local settings under .claude/ stay ignored.
# The parent must be re-included as .claude/* rather than .claude/, because git does not
# descend into an excluded DIRECTORY and a negation inside it would never be evaluated.
!.claude/skills/

# SPA build artifacts
web/node_modules/
web/dist/

# Env / secrets
*.env
.env*
# GCP service-account keys — NEVER commit
*-sa.json
infra/vertex-dev-sa.json

# Coverage + Terraform local state (keep .terraform.lock.hcl tracked)
.coverage
infra/.terraform/
*.tfstate
*.tfstate.*

# Terraform var files with secrets (OAuth client secret, etc.)
infra/terraform.tfvars
infra/*.auto.tfvars

# Firebase Hosting deploy cache (regenerated on every deploy)
web/.firebase/
docs/perkins-analysis/
.morpheus/

# Committed on purpose: NON-SECRET deploy config (site URL, username, public OAuth client id).
# scripts/deploy.sh sources it, so a deploy must be reproducible from git alone (R3) — CI has no
# .env. The broad *.env rules above would otherwise silently exclude it and break the CI deploy.
!infra/deploy.config.env

# Committed on purpose: NON-SECRET terraform inputs (zone id + PUBLIC DKIM value). Without them
# in git, cloudflare_zone_id defaults to "" everywhere except one laptop and every count-guarded
# Cloudflare resource plans as DESTROY — all DNS/MX/SPF/DKIM/DMARC/WAF for perkinsroofing.net.
# The Cloudflare API TOKEN stays out of git (Secret Manager -> TF_VAR_cloudflare_api_token).
!infra/perkins.auto.tfvars

# google-github-actions/auth@v2 writes its short-lived WIF credential into the WORKSPACE as
# gha-creds-<hash>.json. Untracked, it makes `git status --porcelain` non-empty, and deploy.sh's
# R3-ENFORCE guard then refuses to deploy a "dirty tree". Ignoring it keeps that guard meaningful
# AND guarantees a credential file can never be committed.
gha-creds-*.json

# Build artifact: regenerated by scripts/build_tidal_layer.py from the committed .json.
# Must exist before zipping the plugin — checker.js prefers it (the WP host sends no gzip).
wp-plugin/perkins-metal-warranty/assets/tidal.geojson.gz

# Local A/B review media (2026-08-12) — demo artifacts, not source
ab-review/

# Local CompanyCam HTML/SQLite scratch — not the portfolio pipeline
scripts/generate_tagged_projects_local.py
